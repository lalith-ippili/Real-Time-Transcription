# ───────────────────────────────────────────────────────────────
#  Backend environment variables
#  Copy to `.env` for local development:  cp .env.example .env
#  On Vercel: Project → Settings → Environment Variables
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ── PostgreSQL (Supabase) ──────────────────────────────────────
# For Vercel use the *Transaction pooler* string (port 6543) from
# Supabase → Project → Connect. The direct host (db.<ref>.supabase.co:5432)
# is IPv6-only and is NOT reachable from Vercel functions.
#
# Pooler (recommended for Vercel):
# DATABASE_URL=postgresql://postgres.jdcmwroecgvidfgcucvw:[YOUR-DATABASE-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Direct (fine for local dev if your network supports IPv6):
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.jdcmwroecgvidfgcucvw.supabase.co:5432/postgres
#
# Local Postgres alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/speech_to_text

# auto = SSL on for every host except localhost
DB_SSL=auto
DB_POOL_MAX=3
# Create/upgrade the table automatically on cold start
DB_AUTO_MIGRATE=true

# Not used by the API (it connects to Postgres directly); kept for reference.
SUPABASE_URL=https://jdcmwroecgvidfgcucvw.supabase.co

# ── Gemini Live (real-time transcription) ──────────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_API_VERSION=v1alpha
GEMINI_LOCK_CONFIG=true
GEMINI_TOKEN_TTL_MINUTES=30

# ── CORS (comma separated; wildcards allowed) ──────────────────
CORS_ORIGIN=http://localhost:5173,https://realtimetranscription.netlify.app,https://*--realtimetranscription.netlify.app

# ── Rate limits (per IP per minute) ────────────────────────────
RATE_LIMIT_PER_MINUTE=120
TOKEN_RATE_LIMIT_PER_MINUTE=10
